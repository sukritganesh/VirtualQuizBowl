{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Virtual Quiz Bowl trivia set",
  "type": "object",
  "required": ["mode", "title", "questions"],
  "additionalProperties": false,
  "properties": {
    "mode": { "const": "trivia" },
    "title": { "$ref": "#/$defs/nonblank" },
    "category": { "$ref": "#/$defs/nonblank" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "description": "Questions in play order. Each id is unique within this set.",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "nonblank": { "type": "string", "pattern": "\\S" },
    "question": {
      "type": "object",
      "required": ["id", "question", "answer"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonblank" },
        "question": {
          "type": "string",
          "description": "One spoken interrogative sentence of 1 to 25 words, separated by single spaces, ending in a question mark.",
          "pattern": "^[^\\s?!]+(?: [^\\s?!]+){0,24}\\?$"
        },
        "answer": { "$ref": "#/$defs/nonblank" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonblank" },
          "default": []
        }
      }
    }
  }
}
